# ClaimLens AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (local demo, default):
DATABASE_URL=sqlite:///./claimlens.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/claimlens

# ─── Security ──────────────────────────────────────────────────────────────────
# CHANGE THIS in production! Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production-1234567890abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME=ClaimLens AI
DEMO_MODE=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=ClaimLens AI
NEXT_PUBLIC_DEMO_MODE=true

# ─── Supabase (optional — leave blank to use local SQLite) ───────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=claimlens-documents

# ─── Demo Accounts ─────────────────────────────────────────────────────────────
# These are pre-seeded demo accounts (do NOT use in production):
# patient1@demo.claimlens.ai  /  Demo@Patient1
# patient2@demo.claimlens.ai  /  Demo@Patient2
# investigator@demo.claimlens.ai  /  Demo@Invest1
# admin@demo.claimlens.ai  /  Demo@Admin1
